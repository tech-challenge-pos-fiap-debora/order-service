# Copia para .env (na raiz).
#
# Na máquina host (yarn start:dev / seed / testes): Mongo do compose em 27018.
MONGODB_URI=mongodb://localhost:27018/order
MONGODB_DB=order
#
# Compose: host `order-mongo` (porta 27017). Kubernetes: host `order-mongo`.
# mongodb://order-mongo:27017/order

# Integrações (sem URL a chamada falha com 503 e erro claro).
# IDENTITY_SERVICE_URL=http://identity:3000
# STOCK_SERVICE_URL=http://stock:3000
# INTEGRATION_SERVICE_TOKEN=
# INTEGRATION_TIMEOUT_MS=5000

JWT_SECRET=altere-este-segredo
JWT_EXPIRES_IN=1d
PORT=3000

SERVICE_NAME=order-service
NEW_RELIC_APP_NAME=order-service
NEW_RELIC_LABELS=service:order-service;component:order
# NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
